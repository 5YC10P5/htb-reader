{
  "manifest_version": 2,
  "name": "HTB Reader",
  "version": "1.0.0",
  "description": "Listen to Hack The Box Academy lessons in a natural voice. Uses the free Kokoro voice model running on your own PC. Not affiliated with Hack The Box.",
  "homepage_url": "https://github.com/5YC10P5/htb-reader",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "htb-reader@5YC10P5",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "menus",
    "downloads",
    "tabs",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": ["lib/speech-text.js", "lib/settings.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["https://academy.hackthebox.com/*"],
      "js": ["lib/settings.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "HTB Reader",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-play": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Play / pause"
    },
    "next": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "Next paragraph"
    },
    "prev": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "Previous paragraph"
    },
    "faster": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "Speak faster"
    },
    "slower": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "Speak slower"
    },
    "media-play-pause": {
      "suggested_key": { "default": "MediaPlayPause" },
      "description": "Play / pause (media key, headphone button)"
    },
    "media-next": {
      "suggested_key": { "default": "MediaNextTrack" },
      "description": "Next paragraph (media key)"
    },
    "media-prev": {
      "suggested_key": { "default": "MediaPrevTrack" },
      "description": "Previous paragraph (media key)"
    }
  }
}
